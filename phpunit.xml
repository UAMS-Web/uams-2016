<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         failOnEmptyTestSuite="true"
         beStrictAboutOutputDuringTests="true">
    <!--
        The Unit suite only, on Pest 5. No WordPress, no database: WordPress functions are
        mocked with Brain Monkey. The Integration suite runs in its own process from
        tests/Integration/composer.json and tests/Integration/phpunit.xml (PHPUnit 9.6).
    -->
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
    </testsuites>
    <!--
        The population a coverage run measures: the theme's own PHP, 88 files
        (the 24 at the theme root, setup/, widgets/, templates/ and inc/). The
        vendored and unused trees are left out.
    -->
    <source>
        <include>
            <directory suffix=".php">./</directory>
        </include>
        <exclude>
            <directory>./vendor</directory>
            <directory>./node_modules</directory>
            <directory>./tests</directory>
            <directory>./_includes</directory>
            <directory>./assets</directory>
            <directory>./docs</directory>
            <directory>./widgets-unused</directory>
            <directory>./setup/cuztom</directory>
            <directory>./setup/_cuztom</directory>
        </exclude>
    </source>
</phpunit>
