{
    "name": "uams-web/uams-2016",
    "description": "The UAMS 2016 WordPress theme. This file holds development dependencies only: nothing in it is installed on a site.",
    "type": "wordpress-theme",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "brain/monkey": "^2.7",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^5.3",
        "php-stubs/wordpress-stubs": "^6.8",
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.8",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload-dev": {
        "psr-4": {
            "UAMS\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.27"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint:floor": "@php scripts/lint-floor.php",
        "setup:integration": "@composer install --working-dir=tests/Integration",
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "pest",
        "test:integration": "@php tests/Integration/vendor/bin/phpunit --configuration tests/Integration/phpunit.xml",
        "mutate": "pest --mutate --parallel --path=404.php,application.php,archive.php,breadcrumbs.php,comments.php,content-archive.php,content-image.php,content-link.php,content-page.php,content-pdf.php,content.php,footer.php,functions.php,header-image.php,header.php,image.php,inc/template-functions.php,index.php,menu-mobile.php,page.php,rector-sweep.php,rector.php,scripts/lint-floor.php,search.php,searchform.php,setup/class.accordion-shortcode.php,setup/class.button-shortcode.php,setup/class.cards-shortcode.php,setup/class.dropdowns_walker.php,setup/class.filters.php,setup/class.googleapps.php,setup/class.grid-shortcode.php,setup/class.images.php,setup/class.install.php,setup/class.maps-shortcode.php,setup/class.menu-shortcode.php,setup/class.mimes.php,setup/class.squish_bugs.php,setup/class.subpage-list-shortcode.php,setup/class.tabs-shortcode.php,setup/class.tile-box-shortcode.php,setup/class.tiny-shortcode.php,setup/class.uams-acf.php,setup/class.uams-basic-custom-post.php,setup/class.uams-carousel.php,setup/class.uams-documentation-dashboard-widget.php,setup/class.uams-dropdowns.php,setup/class.uams-enclosure.php,setup/class.uams-homeslider-meta-box.php,setup/class.uams-iframes.php,setup/class.uams-media-caption.php,setup/class.uams-media-credit.php,setup/class.uams-oembeds.php,setup/class.uams-page-attributes-meta-box.php,setup/class.uams-quicklinks.php,setup/class.uams-replace-media.php,setup/class.uams-scripts.php,setup/class.uams-settings.php,setup/class.uams-sidebar-menu-walker.php,setup/class.uams-plugins.php,setup/class.uams-shortcodes.php,setup/class.uams-styles.php,setup/class.uams-tinymce.php,setup/custom-post-types.php,setup/class.uams.php,setup/class.users.php,setup/class.youtube-shortcode.php,sidebar.php,templates/template-big-hero.php,templates/template-blank.php,templates/template-home.php,templates/template-no-hero.php,templates/template-no-sidebar.php,templates/template-no-title.php,templates/template-sitemap.php,templates/template-small-hero.php,thinstrip.php,woocommerce.php,widgets/class.uams-sidebar.php,widgets/class.uams-intro.php,widgets/class.uams-social.php",
        "stan": [
            "@setup:integration",
            "phpstan analyse --no-progress --memory-limit=2G"
        ],
        "refactor": "rector",
        "refactor:sweep": "rector --clear-cache --config=rector-sweep.php",
        "test:refactor": "rector --dry-run",
        "test:refactor:sweep": "rector --dry-run --clear-cache --config=rector-sweep.php",
        "pint": "pint",
        "test:pint": "pint --test"
    },
    "scripts-descriptions": {
        "lint:floor": "Parse every shipped PHP file; run it under the PHP floor (8.2) to prove none uses newer syntax.",
        "setup:integration": "Install the Integration suite's own Composer setup (PHPUnit 9.6, wp-phpunit, the polyfills).",
        "test": "Run both suites, each in its own process, so the Unit suite never sees WordPress.",
        "test:unit": "Run the Pest suite that needs no WordPress and no database.",
        "test:integration": "Run the PHPUnit 9.6 suite that boots WordPress through wp-phpunit against the test database.",
        "mutate": "Run Pest mutation testing over the files brought to the Full coverage bar (the #102 slices so far); pass --path=<files> to narrow it.,widgets/class.uams-sidebar.php,widgets/class.uams-intro.php,widgets/class.uams-social.php",
        "stan": "Install the Integration suite's Composer setup (PHPStan scans its WordPress test classes), then run PHPStan at the level in phpstan.neon.dist.",
        "refactor": "Apply the gating Rector profile.",
        "refactor:sweep": "Apply the sweep Rector profile (run deliberately, review the diff).",
        "test:refactor": "Preview the gating Rector profile; fails when it would change anything.",
        "test:refactor:sweep": "Preview the sweep Rector profile.",
        "pint": "Format the theme with Pint (laravel preset).",
        "test:pint": "Check formatting with Pint without changing anything."
    }
}
